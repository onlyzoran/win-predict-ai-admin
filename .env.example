# Public app URL (no trailing slash). Used in magic-link emails.
# Also set as NUXT_APP_URL for the Nitro server.
NUXT_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SQLite database file path (relative to cwd or absolute)
NUXT_DATABASE_PATH=.data/admin.sqlite
DATABASE_PATH=.data/admin.sqlite

# Comma-separated bootstrap admin emails (seeded into SQLite users on startup;
# source of truth after that is the Admins UI / users table)
NUXT_ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=you@example.com

# Resend API key. If empty, magic links are printed to the server console (dev).
NUXT_RESEND_API_KEY=
RESEND_API_KEY=

# Sender address (must be verified in Resend, or use onboarding@resend.dev)
NUXT_MAIL_FROM=onboarding@resend.dev
MAIL_FROM=onboarding@resend.dev

# Secret used to hash session / magic-link tokens
NUXT_SESSION_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string

# Nest sports API (sidecar). Nuxt proxies /api/sports → this port.
API_PORT=3001
NUXT_API_PORT=3001

# Optional public path prefix (default /)
# NUXT_APP_BASE_URL=/
